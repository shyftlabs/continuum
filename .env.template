# ── LLM Provider Keys ────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key        # optional 
GEMINI_API_KEY=your-gemini-api-key        # optional
# ANTHROPIC_API_KEY=your-anthropic-api-key  # optional

# ── Default LLM ──────────────────────────────────────────────────────────────
DEFAULT_LLM_MODEL=gemini/gemini-2.5-flash
FALLBACK_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.7
DEFAULT_LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_ENABLE_FALLBACK=true

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=openai/text-embedding-3-small  # use provider/model prefix when routing through gateway
EMBEDDING_DIMS=1536
# EMBEDDER_API_KEY=  # explicit key (falls back to SMART_GATEWAY_API_KEY when EMBEDDER_API_BASE is set)
EMBEDDER_API_BASE=https://continuum.shyftops.io/v1

# ── Memory (mem0 + Milvus) ───────────────────────────────────────────────────
MEMORY_ENABLED=true
VECTOR_STORE_PROVIDER=milvus
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=   # auth key for Qdrant. Required for Qdrant Cloud; also
#                   # secures a self-hosted instance. Set this (non-empty)
#                   # and the bundled Docker Qdrant server picks it up
#                   # automatically (QDRANT__SERVICE__API_KEY) while
#                   # Continuum's client sends the same value. Leave blank
#                   # for keyless local dev (Qdrant is loopback-only).
QDRANT_COLLECTION=orchestrator_memories_openai
MILVUS_HOST=localhost
MILVUS_PORT=19530
# MILVUS_URI: full endpoint URL. Overrides MILVUS_HOST/MILVUS_PORT when set.
#             Required for Zilliz Cloud and any TLS endpoint — host/port can
#             only express http://host:port. Zilliz serves TLS on the implicit
#             443, so https://host:19530 is wrong too; give the full URL.
#             e.g. https://in03-xxx.serverless.gcp-us-west1.cloud.zilliz.com
# MILVUS_URI=
# MILVUS_TOKEN: auth token for Milvus. "user:password" for a self-hosted
# instance with RBAC enabled, or an API key for Zilliz Cloud. Empty = no auth.
# Fail-closed guard (F8/D4): a REMOTE (non-loopback) Qdrant/Milvus with a
# missing/weak key is REJECTED at startup; a local/loopback store may run
# tokenless. Override for local/testing with CONTINUUM_ALLOW_INSECURE=1.
MILVUS_TOKEN=
MILVUS_COLLECTION=orchestrator_memories
# Memory fact-extraction LLM.
# When SMART_GATEWAY_URL is set, fact extraction is routed through Smart
# Inference at the cheap tier (auto/cheap) — the only tier compatible with
# mem0's json_schema + forced tool_choice calls (mid/quality resolve to
# thinking models that reject them). This value is the direct-provider
# fallback used only when no gateway is configured.
MEMORY_LLM_MODEL=gemini/gemini-2.5-flash
MEMORY_LLM_TEMPERATURE=0.1
MEMORY_ISOLATION=user
MEMORY_SEARCH_LIMIT=5
MEMORY_HISTORY_DB_PATH=~/.orchestrator/memory_history.db

# ── Session (Redis) ───────────────────────────────────────────────────────────
SESSION_ENABLED=true
SESSION_REDIS_HOST=localhost
SESSION_REDIS_PORT=6380
# Fail-closed guard (F8/D2): a blank or CHANGEME placeholder value below is
# REJECTED at startup, even on localhost — replace it with a strong secret
# (`openssl rand -hex 32`). For local/testing against unauthenticated Redis,
# set CONTINUUM_ALLOW_INSECURE=1 to downgrade the refusal to a warning.
SESSION_REDIS_PASSWORD=CHANGEME_generate_with_openssl_rand_hex_32
SESSION_REDIS_DB=0
SESSION_REDIS_SSL=false
SESSION_REDIS_MAX_CONNECTIONS=10  
SESSION_TTL_SECONDS=172800
SESSION_MAX_MESSAGES=1000
SESSION_KEY_PREFIX=orchestrator:session

# ── Session Ownership and Security ────────────────────────────────────────────
# A session id names storage — it is not proof of who is calling. These settings
# control how that is enforced. Sessions created without a user_id have no owner
# and are unaffected by any of them.

# What happens when a caller touches a session owned by a different principal.
#   open    - log it quietly, allow the call (pre-ownership behaviour)
#   audit   - log a warning + emit a metric, allow the call. Use this to measure
#             what enforcement would break, before turning it on.
#   enforce - raise SessionOwnershipError
SESSION_OWNERSHIP=enforce # open | audit | enforce(default)

# Whether "the caller identified nobody" counts as an ownership problem.
# true  - an owned session is reachable only by a caller that bound a principal
# false - holding the session id is enough (capability access)
#
# Ships false, for compatibility rather than safety: an application written
# before bind_principal() existed names no principal, and requiring one would
# refuse it on upgrade.
#
# Note SESSION_OWNERSHIP=enforce does NOT cover this path — it refuses a caller
# who gives the wrong identity, not one who gives none. And with
# SESSION_HASH_IDS also off, the session id is derived in plaintext from the
# user id, so anyone who knows a user id can construct it and present it while
# naming nobody. Before running multi-tenant, set either this to true or
# SESSION_HASH_IDS to true; either one closes it.
SESSION_REQUIRE_PRINCIPAL=false # true | false(default)

# Your application binds the principal at its auth boundary, from a credential
# it has verified. The framework never derives one — it cannot tell a validated
# identity from a string someone typed:
#
#     from continuum.session import bind_principal
#     user = verify_jwt(request.headers["Authorization"])
#     with bind_principal(user.id):
#         await runner.run(...)
#
# Upgrading an app that does not do this yet? SESSION_REQUIRE_PRINCIPAL already
# ships off, so nothing breaks. Set SESSION_OWNERSHIP=audit while you adopt
# bind_principal() — it reports what enforcement would refuse without refusing
# it — then put it back to enforce and turn SESSION_REQUIRE_PRINCIPAL on.

# Derive session ids as an HMAC instead of storing identifiers in plaintext.
#   false - id is "u:{user_id}" / "c:{conversation_id}:u:{user_id}". Readable,
#           and CONSTRUCTIBLE by anyone who knows a user id.
#   true  - id is "s_<hex>". Still deterministic (a returning user resolves to
#           the same session), but not derivable, and it keeps user identifiers
#           out of Redis keys, log lines and traces.
# Existing plaintext sessions migrate to their new keys on first access.
SESSION_HASH_IDS=false # true | false(default), opaque vs plaintext keys

# HMAC key for SESSION_HASH_IDS. Required when it is true — startup fails
# otherwise, rather than silently falling back to plaintext. The CHANGEME
# placeholder below is REJECTED at startup too, so copying this file cannot
# leave a deployment running on a secret that is readable in the repository.
#
#   Generate with:  openssl rand -hex 32
#
# MUST be random, and at least 32 characters — anything shorter or memorable is
# refused. A guessable value defeats the feature entirely: every user of your
# system holds one matched pair (their own user id -> their own session id) and
# can brute-force the secret offline, with no rate limit and no logs. Recovering
# it yields every user's session id.
#
# MUST be identical in every process and stable across restarts. It is a
# derivation parameter, not a per-process random: a different value per worker
# splits one user's history across workers, and changing it re-derives every id,
# orphaning existing sessions.
#
# Set CONTINUUM_ALLOW_INSECURE=1 to downgrade the refusal to a warning
# (local development / throwaway CI only).
SESSION_ID_SECRET=CHANGEME_generate_with_openssl_rand_hex_32

# ── Langfuse Observability ────────────────────────────────────────────────────
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_FLUSH_INTERVAL=1
LANGFUSE_FLUSH_AT=15
LANGFUSE_DEBUG=false

# ── Temporal (durable workflows) ─────────────────────────────────────────────
TEMPORAL_ENABLED=true
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=orchestrator-agents
TEMPORAL_ENABLE_HUMAN_IN_LOOP=true
TEMPORAL_APPROVAL_TIMEOUT_SECONDS=86400
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=604800
TEMPORAL_ACTIVITY_START_TO_CLOSE_TIMEOUT=300
TEMPORAL_ACTIVITY_RETRY_MAX_ATTEMPTS=3

# ── Smart Gateway ─────────────────────────────────────────────────────────────
SMART_GATEWAY_URL=https://continuum.shyftops.io/v1
SMART_GATEWAY_API_KEY=your-smart-gateway-api-key

# ── Misc ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SHARED_SERVICES_ENABLED=true
MEM0_TELEMETRY=false
ANONYMIZED_TELEMETRY=false
TOKENIZERS_PARALLELISM=false